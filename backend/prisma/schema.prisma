generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String
  createdAt     DateTime     @default(now())
  familyGroupId String?
  familyGroup   FamilyGroup? @relation(fields: [familyGroupId], references: [id])
  categories Category[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]

  @@index([familyGroupId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FamilyGroup {
  id           String        @id @default(uuid())
  name         String
  inviteCode   String        @unique @default(uuid())
  users        User[]
}

model Transaction {
  id            String      @id @default(uuid())
  amount        Decimal     @db.Decimal(10, 2)
  type          TransactionType
  description   String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date          DateTime
  month         Int
  year          Int
  aiRawInput    String?
  createdAt     DateTime    @default(now())
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId, year, month])
  @@index([categoryId])
}

model Category {
  id            String        @id @default(uuid())
  type          TransactionType
  name          String
  color         String
  icon          String
  monthlyLimit  Decimal?      @db.Decimal(10, 2)
  transactions  Transaction[]
  userId        String
  user          User @relation(fields: [userId], references: [id])
  groupId       String
  group         CategoryGroup @relation(fields: [groupId], references: [id])
  @@unique([userId, name])
}

model CategoryGroup {
  id                String            @id @default(uuid())
  type              TransactionType
  name              String            @unique
  color             String
  icon              String
  defaultCategories DefaultCategory[]
  categories        Category[]
}

model DefaultCategory {
  id      String @id @default(uuid())
  type    TransactionType
  name    String
  color   String
  icon    String
  groupId String
  group   CategoryGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, name])
}

enum TransactionType {
  INCOME
  EXPENSE
}

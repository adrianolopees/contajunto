generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(uuid())
  name              String
  email             String                @unique
  passwordHash      String
  categoriesVersion Int                   @default(1)
  createdAt         DateTime              @default(now())
  familyGroupId     String?
  familyGroup       FamilyGroup?          @relation(fields: [familyGroupId], references: [id])
  categories        Category[]
  transactions      Transaction[]
  refreshTokens     RefreshToken[]
  cards             Card[]
  categoryBudgets   CategoryGroupBudget[]

  @@index([familyGroupId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // login limpa tokens expirados por userId e o cascade do User também
  // filtra por ele — sem índice, ambos varrem a tabela inteira
  @@index([userId])
}

model FamilyGroup {
  id         String @id @default(uuid())
  name       String
  inviteCode String @unique @default(uuid())
  users      User[]
}

model Transaction {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType
  paymentMethod PaymentMethod?
  description   String
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cardId        String?
  card          Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  date          DateTime
  month         Int
  year          Int
  aiRawInput    String?
  createdAt     DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  @@index([userId, year, month])
  @@index([categoryId])
  @@index([cardId])
}

model Card {
  id           String        @id @default(uuid())
  name         String
  closingDay   Int
  dueDay       Int
  color        String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id           String          @id @default(uuid())
  type         TransactionType
  name         String
  color        String
  icon         String
  transactions Transaction[]
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  groupId      String
  group        CategoryGroup   @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, name])
}

model CategoryGroup {
  id                String                @id @default(uuid())
  type              TransactionType
  name              String                @unique
  color             String
  icon              String
  defaultCategories DefaultCategory[]
  categories        Category[]
  budgets           CategoryGroupBudget[]
}

// teto de gasto mensal por categoria-pai, por usuário — substitui o antigo
// User.monthlyBudget (teto único). CategoryGroup é global (compartilhado
// entre usuários), então o teto não pode morar nela direto; opcional por
// natureza (sem linha aqui = sem teto configurado pro grupo)
model CategoryGroupBudget {
  id        String        @id @default(uuid())
  amount    Decimal       @db.Decimal(10, 2)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     CategoryGroup @relation(fields: [groupId], references: [id])
  createdAt DateTime      @default(now())

  @@unique([userId, groupId])
}

model DefaultCategory {
  id      String          @id @default(uuid())
  type    TransactionType
  name    String
  color   String
  icon    String
  groupId String
  group   CategoryGroup   @relation(fields: [groupId], references: [id])

  @@unique([groupId, name])
}

// Singleton (id = 1). `version` é escrita SÓ pelo seed, que a incrementa quando
// o hash do catálogo muda — o login compara User.categoriesVersion com isto, e
// não com uma constante em código. Assim deploy e seed não conseguem divergir:
// enquanto o seed não roda, ninguém é marcado como "em dia".
model CatalogMeta {
  id          Int      @id @default(1)
  version     Int
  contentHash String
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  DEBIT
  CREDIT
  PIX
  CASH
}

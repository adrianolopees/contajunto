# Copie para .env e preencha. Nunca commite o .env real.

# String de conexão do PostgreSQL.
# Local (Docker): postgresql://contajunto:contajunto123@localhost:5433/contajunto_dev
# Produção (Neon): use a connection string direta, com ?sslmode=require
DATABASE_URL="postgresql://contajunto:contajunto123@localhost:5433/contajunto_dev"

# Segredo de assinatura do JWT. Em produção gere um novo:
#   openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Porta do servidor. Em produção o host injeta PORT automaticamente.
PORT=3333

# "development" | "production" | "test"
# Em "production" o Express também serve o build da SPA (frontend/dist).
NODE_ENV="development"

# Origem permitida no CORS (só usada em dev; em produção a origem é única).
CORS_ORIGIN="http://localhost:5173"
